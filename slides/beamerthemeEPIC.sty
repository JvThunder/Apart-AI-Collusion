% EPIC Lab Beamer theme
% Major colours: Oxford blue and Amazon orange
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeEPIC}[2026/07/21 EPIC Lab presentation theme]

\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}
\RequirePackage{xcolor}

\setbeamerfont{footnote}{size=\tiny}
\setbeamerfont{footnote mark}{size=\tiny}

% ------------------------------------------------------------------
% Colours
% ------------------------------------------------------------------
\definecolor{OxfordBlue}{HTML}{002147}
\definecolor{AmazonOrange}{HTML}{FF9900}
\definecolor{EPICText}{HTML}{111827}
\definecolor{EPICMuted}{HTML}{6B7280}
\definecolor{EPICLightGrey}{HTML}{E5E7EB}
\definecolor{EPICPanel}{HTML}{F7F8FA}
\definecolor{OxfordBlueLight}{HTML}{DAE4F0}
\definecolor{EPICSuccess}{HTML}{166534}

% ------------------------------------------------------------------
% Fonts and global style
% ------------------------------------------------------------------
\mode<presentation>
\usefonttheme{professionalfonts}
\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize}
\setbeamerfont{normal text}{size=\normalsize}
\setbeamerfont{block title}{series=\bfseries}

\setbeamercolor{normal text}{fg=EPICText,bg=white}
\setbeamercolor{structure}{fg=OxfordBlue}
\setbeamercolor{frametitle}{fg=OxfordBlue,bg=white}
\setbeamercolor{framesubtitle}{fg=EPICMuted,bg=white}
\setbeamercolor{title}{fg=OxfordBlue,bg=white}
\setbeamercolor{subtitle}{fg=EPICMuted,bg=white}
\setbeamercolor{author}{fg=EPICText,bg=white}
\setbeamercolor{institute}{fg=EPICMuted,bg=white}
\setbeamercolor{date}{fg=EPICMuted,bg=white}
\setbeamercolor{item}{fg=AmazonOrange}
\setbeamercolor{subitem}{fg=OxfordBlue}
\setbeamercolor{caption name}{fg=OxfordBlue}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\color{AmazonOrange}$\blacktriangleright$}
\setbeamertemplate{itemize subitem}{\color{OxfordBlue}$\bullet$}
\setbeamertemplate{enumerate item}{\color{AmazonOrange}\insertenumlabel.}
\setbeamertemplate{caption}[numbered]

% ------------------------------------------------------------------
% Blocks
% ------------------------------------------------------------------
\setbeamercolor{block title}{fg=white,bg=OxfordBlue}
\setbeamercolor{block body}{fg=EPICText,bg=EPICPanel}
\setbeamercolor{block title alerted}{fg=white,bg=AmazonOrange}
\setbeamercolor{block body alerted}{fg=EPICText,bg=EPICPanel}
\setbeamercolor{block title example}{fg=white,bg=OxfordBlue!85!black}
\setbeamercolor{block body example}{fg=EPICText,bg=EPICPanel}

% ------------------------------------------------------------------
% Logo paths. Override in your preamble with \epicsetlogos{...}{...}
% ------------------------------------------------------------------
\newcommand{\epiclogopath}{assets/epic_logo.png}
\newcommand{\ntuccdspath}{assets/ntu_ccds_logo.png}
\newcommand{\epicsetlogos}[2]{%
  \renewcommand{\epiclogopath}{#1}%
  \renewcommand{\ntuccdspath}{#2}%
}

\newcommand{\epiclablogo}[1][1.5cm]{%
  \IfFileExists{\epiclogopath}{\includegraphics[width=#1]{\epiclogopath}}{\textbf{\textcolor{OxfordBlue}{EP}\textcolor{AmazonOrange}{IC}}}%
}
\newcommand{\ntuccdslogo}[1][2.6cm]{%
  \IfFileExists{\ntuccdspath}{\includegraphics[width=#1]{\ntuccdspath}}{\textcolor{OxfordBlue}{NTU \; | \; CCDS}}%
}

% ------------------------------------------------------------------
% Frame title
% ------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \vspace{0.55cm}%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=0.75cm,rightskip=0cm]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle\par
    \ifx\insertframesubtitle\@empty\else
      \vspace{0.05cm}{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}\par
    \fi
  \end{beamercolorbox}
  \vspace{0.15cm}
  \begin{tikzpicture}[remember picture,overlay]
    \fill[AmazonOrange] (0.75,0.02) rectangle (2.25,0.055);
    \fill[OxfordBlue] (2.28,0.02) rectangle (11.25,0.035);
  \end{tikzpicture}%
}

% ------------------------------------------------------------------
% Footer
% ------------------------------------------------------------------
\setbeamertemplate{footline}{%
  \leavevmode%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south west] at ([xshift=0.45cm,yshift=0.22cm]current page.south west) {\epiclablogo[0.88cm]};
    \node[anchor=south east] at ([xshift=-0.45cm,yshift=0.22cm]current page.south east) {\ntuccdslogo[1.95cm]};
    \node[anchor=south] at ([yshift=0.26cm]current page.south) {\scriptsize\textcolor{EPICMuted}{\insertshorttitle\hspace{0.7em}|\hspace{0.7em}\insertframenumber/\inserttotalframenumber}};
  \end{tikzpicture}%
  \vspace{0.82cm}%
}

\setbeamertemplate{background canvas}{\epicdecor}

% ------------------------------------------------------------------
% Title page
% ------------------------------------------------------------------
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[white] (current page.south west) rectangle (current page.north east);
    \epicdecor
    \fill[OxfordBlue] ([xshift=0.0cm,yshift=0cm]current page.south west) rectangle ([xshift=0.18cm,yshift=0cm]current page.north west);
    \fill[AmazonOrange] ([xshift=0.18cm,yshift=0cm]current page.south west) rectangle ([xshift=0.25cm,yshift=0cm]current page.north west);
    % Keep the two identities together as a single logo row.
    \node[anchor=north west,inner sep=0pt] at ([xshift=0.80cm,yshift=-0.62cm]current page.north west) {%
      \begin{minipage}{0.48\paperwidth}
        \raggedright
        \epiclablogo[2.15cm]\hspace{0.45cm}\raisebox{0.08cm}{\ntuccdslogo[2.9cm]}
      \end{minipage}%
    };
    % A restrained orange rule visually anchors the two logos.
    % \vspace{1cm}
    % \fill[AmazonOrange] ([xshift=0.80cm,yshift=-1.62cm]current page.north west)
    %   rectangle ([xshift=-0.80cm,yshift=-1.59cm]current page.north east);
  \end{tikzpicture}
  % The title block is deliberately placed above the geometric centre.
  \vspace{0.95cm}
  \begin{flushleft}
    \hspace{0.55cm}\begin{minipage}{0.84\paperwidth}
      {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
      \vspace{0.14cm}
      {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
      \vspace{0.55cm}
      {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}
      \vspace{0.1cm}
      {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}
      \vspace{0.2cm}
      {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}
    \end{minipage}
  \end{flushleft}
}

% ------------------------------------------------------------------
% Section divider
% ------------------------------------------------------------------
\AtBeginSection[]{%
  \begin{frame}[plain,noframenumbering]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[OxfordBlueLight] (current page.south west) rectangle (current page.north east);
      \fill[AmazonOrange] ([xshift=0cm,yshift=0cm]current page.south west) rectangle ([xshift=0.16cm,yshift=0cm]current page.north west);
      \node[anchor=south west] at ([xshift=0.55cm,yshift=0.35cm]current page.south west) {\epiclablogo[1.35cm]};
      \draw[OxfordBlue,opacity=0.10,line width=1.5pt] ([xshift=-1.6cm,yshift=-0.5cm]current page.north east) circle (1.8cm);
      \draw[OxfordBlue,opacity=0.10,line width=1.5pt] ([xshift=-0.2cm,yshift=-0.9cm]current page.north east) circle (2.5cm);
    \end{tikzpicture}
    \vfill
    \hspace{0.45cm}\begin{minipage}{0.82\paperwidth}
      {\color{AmazonOrange!90!black}\Large\bfseries Section \thesection}\par\vspace{0.25cm}
      {\color{OxfordBlue}\Huge\bfseries\insertsectionhead}\par
    \end{minipage}
    \vfill
  \end{frame}}

% ------------------------------------------------------------------
% Helper boxes
% ------------------------------------------------------------------
\newcommand{\takeaway}[1]{%
  \begin{tikzpicture}
    \node[fill=OxfordBlue!4,draw=AmazonOrange,line width=0.8pt,rounded corners=3pt,inner sep=6pt,text width=0.92\linewidth] {\textbf{\textcolor{OxfordBlue}{Takeaway.}} #1};
  \end{tikzpicture}}

\newcommand{\epicquote}[2]{%
  \begin{tikzpicture}
    \node[anchor=west,text=AmazonOrange,font=\fontsize{45}{45}\selectfont] at (0,0) {``};
    \node[anchor=west,text width=0.82\linewidth] at (0.7,0) {\Large\itshape #1\\[0.3em]\normalsize\textcolor{EPICMuted}{--- #2}};
  \end{tikzpicture}}

\mode<all>

% ------------------------------------------------------------------
% Decorative background: light circular arcs similar to the PPT master
% ------------------------------------------------------------------
\newcommand{\epicdecor}{%
\begin{tikzpicture}[remember picture,overlay]
  \draw[EPICLightGrey,line width=1.2pt] ([xshift=-1.6cm,yshift=0.15cm]current page.north east) circle (1.25cm);
  \draw[EPICLightGrey,line width=1.2pt] ([xshift=-0.25cm,yshift=-0.35cm]current page.north east) circle (1.85cm);
  \draw[AmazonOrange,line width=1.0pt] ([xshift=-0.55cm,yshift=-0.72cm]current page.south east) -- ([xshift=-0.15cm,yshift=-0.72cm]current page.south east);
\end{tikzpicture}}
